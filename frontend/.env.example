# GameLearn AI — Frontend environment variables
# Copy to `.env` and adjust per environment. ALL values are optional.

# Base URL of the FastAPI backend. Vite proxies /api in dev, so this is
# mainly used for production deployments.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Development-only preview data.
# When true, the scenario / simulation / performance services fall back to
# clearly-marked DEV data whenever the matching backend endpoints are not yet
# implemented (network error, 404, timeout, or server fault). Auth and
# validation failures are NEVER masked. Set to false in production — the
# backend remains the single source of truth.
VITE_ENABLE_DEV_FALLBACK=false